CXX_STD = CXX23

PKG_CPPFLAGS = -D_FILE_OFFSET_BITS=64 -I../src/gcrank/include

RHTLIBS = $(shell R_PROFILE_USER=/dev/null "$(R_HOME)/bin/Rscript.exe" -e "cat(Rhtslib::pkgconfig('PKG_LIBS'))")

PKG_LIBS = $(RHTLIBS)

GCRANK_OBJECTS = \
	gcrank/src/bitvector.o \
	gcrank/src/crc32.o \
	gcrank/src/fasta_reader.o \
	gcrank/src/gc_rank.o \
	gcrank/src/input_stream.o \
	gcrank/src/line_reader.o \
	gcrank/src/manifest.o \
	gcrank/src/sha256.o \
	gcrank/src/thread_pool.o

OBJECTS = RcppExports.o htslib-utils.o gcrank-wrapper.o $(GCRANK_OBJECTS)
