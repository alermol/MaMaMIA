+int HttpRequest::_on_body(http_parser* pParser, const char* pAt, size_t length) {
+  ASSERT_BACKGROUND_THREAD()
+  debug_log("HttpRequest::_on_body", LOG_DEBUG);
+
+  // Accumulate body bytes in C++ and hand R larger blocks. The default path
+  // calls back into R once per socket read (often 16-64 KiB), which dominates
+  // upload time for large files.
+  _bodyAccum.insert(_bodyAccum.end(), pAt, pAt + length);
+
+  if (_bodyAccum.size() >= (1024 * 1024)) {
+    std::shared_ptr<std::vector<char> > buf =
+      std::make_shared<std::vector<char> >();
+    buf->swap(_bodyAccum);
+    _schedule_body_data(buf);
+  }
 
   return 0;
 }
