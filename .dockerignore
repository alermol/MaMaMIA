# Build context for deployment/Dockerfile. The image needs the application
# sources and deployment/, not the test data or local tooling.
.git
.gitignore
.RData
.Rhistory
.Rproj.user
.Rproj.user/
.uvr/
*.tar.gz
*.Rcheck
**/*.o
**/*.so
test_data/
tests/
lib/
bench-*/
report/
# generated by tools/build-native.R
src/Makevars
src/Makevars.win
