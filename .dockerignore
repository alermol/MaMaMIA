# Build context for deployment/Dockerfile. The image needs the package
# sources and deployment/, not the test data or local tooling.
.git
.gitignore
.RData
.Rhistory
.Rproj.user
.Rproj.user/
.uvr/
*.tar.gz
*.Rcheck
**/*.o
**/*.so
test_data/
tests/
vignettes/
bench-*/
report/
# generated by ./configure during R CMD INSTALL
src/Makevars
src/Makevars.win
